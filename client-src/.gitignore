# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── 이 프로젝트 추가분 ───────────────────────────────────
# 이 폴더는 pnpm 을 쓴다 (pnpm-lock.yaml). npm 으로 한 번 설치하면
# package-lock.json 이 생기는데, 두 락파일이 같이 있으면 사람마다
# 다른 버전이 깔린다. 커밋되지 않도록 막아둔다.
package-lock.json

# 비밀값
*.key
secrets/

# macOS / 에디터
._*
.vscode/
.idea/

# 촬영 원본·합성 결과물은 커밋하지 않는다 (개인정보 + 용량)
captures/
output/
prints/
uploads/
*.HEIC
*.heic
